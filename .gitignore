# ─────────────────────────────────────────────
# Secrets & environment
# ─────────────────────────────────────────────
.env
*/.env
**/.env
!.env.example
!**/.env.example

# ─────────────────────────────────────────────
# Mesure (évaluation chapitre 4) — journaux bruts non versionnés
# ─────────────────────────────────────────────
measurements/*.jsonl
!measurements/.gitkeep
observation_runs/

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ─────────────────────────────────────────────
# AI model weights (large binaries — provide out-of-band)
# ─────────────────────────────────────────────
*.pt
*.onnx
*.pth
*.caffemodel
~/.insightface/
~/.EasyOCR/

# ─────────────────────────────────────────────
# Node / Next.js
# ─────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# ─────────────────────────────────────────────
# Uploads & generated media (runtime data)
# ─────────────────────────────────────────────
**/uploads/*
!**/uploads/.gitkeep
**/cropped/*
!**/cropped/.gitkeep
**/snapshots/*
**/logs/*
*.log

# Planches d'audit contenant des images terrain : conserver localement, ne pas
# publier dans Git. Les verdicts et scripts reproductibles restent versionnés.
audit_vacances_*/**/*.jpg
audit_vacances_*/*.jpg

# ─────────────────────────────────────────────
# OS / IDE
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
