# ─────────────────────────────────────────────
# Secrets & environment
# ─────────────────────────────────────────────
.env
*/.env
**/.env
!.env.example
!**/.env.example

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ─────────────────────────────────────────────
# AI model weights (large binaries — provide out-of-band)
# ─────────────────────────────────────────────
*.pt
*.onnx
*.pth
*.caffemodel
~/.insightface/
~/.EasyOCR/

# ─────────────────────────────────────────────
# Node / Next.js
# ─────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# ─────────────────────────────────────────────
# Uploads & generated media (runtime data)
# ─────────────────────────────────────────────
**/uploads/*
!**/uploads/.gitkeep
**/cropped/*
!**/cropped/.gitkeep
**/snapshots/*
**/logs/*
*.log

# ─────────────────────────────────────────────
# OS / IDE
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
