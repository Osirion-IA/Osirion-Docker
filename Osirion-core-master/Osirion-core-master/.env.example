# =====================================================
# CONFIGURATION OSIRION-CORE
# =====================================================
# Copier ce fichier en ".env" et remplir avec vos valeurs réelles.
# IMPORTANT : Ne jamais committer le fichier .env dans git.
#
# Démarrage rapide :
#   cp .env.example .env
#   # éditer .env avec vos valeurs
#   docker compose up -d
# =====================================================


# ----------------------
# API Backend (obligatoire)
# ----------------------
# URL de base du serveur API (avec slash final)
API_URL=http://192.168.0.103:8000/

# Identifiants de connexion à l'API
AUTH_EMAIL=votre-email@example.com
AUTH_PASSWORD=votre-mot-de-passe-securise


# ----------------------
# Sécurité WebSocket (obligatoire)
# ----------------------
# Secret Flask pour signer les sessions — NE JAMAIS hardcoder en production.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=GENERER_UN_SECRET_ALEATOIRE_ICI

# Origines autorisées pour les connexions WebSocket (séparées par des virgules).
# Développement : http://localhost:3000,http://127.0.0.1:3000
# Production    : https://votre-domaine.com
# Toutes        : * (DANGEREUX — ne pas utiliser en production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ----------------------
# Mode debug (optionnel)
# ----------------------
debug=False


# ----------------------
# Logging (optionnel — valeurs par défaut ci-dessous)
# ----------------------
# Niveau : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Répertoire de sortie des fichiers de logs
LOG_DIR=logs

# Logs JSON structurés (recommandé pour agrégateurs comme Loki, ELK)
ENABLE_JSON_LOGS=false

# Sortie console (désactiver pour réduire le bruit en production)
ENABLE_CONSOLE_LOGS=true

# Taille maximale d'un fichier de log avant rotation (en octets, 10 MB par défaut)
LOG_MAX_BYTES=10485760

# Nombre de fichiers de backup à conserver après rotation
LOG_BACKUP_COUNT=5


# ----------------------
# Reconnaissance faciale — résolution de traitement & qualité (précision)
# ----------------------
# Résolution de TRAITEMENT (détection + alignement ArcFace). Indépendante de la
# vidéo affichée (WebRTC/MediaMTX) : la monter améliore la reconnaissance des
# visages distants au prix du GPU. 1280×720 par défaut ; 960×540 ou 640×480 pour
# alléger sur RTX 4050 avec beaucoup de caméras.
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Résolution d'entrée du détecteur SCRFD — doit suivre la frame (sinon SCRFD
# re-réduit l'image en interne). 960 par défaut ; 640 pour alléger.
FACE_DET_SIZE=960

# Garde-fou de frontalité (0.0–1.0) : ignore les profils extrêmes à la
# reconnaissance (embedding ArcFace dégradé). 0.25 = ne rejette que les
# quasi-profils. 0 = désactivé.
FACE_MIN_FRONTALITY=0.25

# Garde-fou de netteté du crop de visage (variance du Laplacien). 25.0 = défaut
# (conservateur : ne rejette que le flou de mouvement franc). 0.0 = désactivé.
FACE_CROP_MIN_SHARPNESS=25.0

# Best-shot : pondère le vote temporel par la qualité du visage (frontalité,
# taille, netteté) → l'identité est décidée par les BONNES frames. true = défaut
# (sûr : si toutes les qualités sont égales, comportement identique à avant).
FACE_QUALITY_WEIGHTED_VOTE=true
# Références de qualité « idéale » (facteur = 1.0 au-delà). 110 px ≈ natif ArcFace.
FACE_QUALITY_REF_SIZE=110
FACE_QUALITY_REF_SHARPNESS=120.0

# ── Sprint 2 — Backbone & accélération d'inférence ───────────────────────────
# Pack de modèles InsightFace. DOIT être IDENTIQUE sur le Core ET le backend
# (sinon galerie et requêtes sont incompatibles). antelopev2 = ResNet-100 (haute
# précision) ; buffalo_l = ResNet-50 (plus léger). CHANGER DE PACK = ré-enrôler.
INSIGHTFACE_MODEL_PACK=antelopev2

# ONNX Runtime — bornage des threads CPU (anti-monopolisation des cœurs).
ONNX_INTRA_OP_THREADS=4
ONNX_INTER_OP_THREADS=2
# Plafond mémoire GPU par session (Go) + réglages CUDA.
ONNX_GPU_MEM_LIMIT_GB=2
ONNX_ARENA_EXTEND_STRATEGY=kNextPowerOfTwo
ONNX_CUDNN_CONV_ALGO=EXHAUSTIVE

# FP16 réel via TensorRT (optionnel ; 1er build de moteur long). false = défaut.
FACE_TRT_FP16=false
ONNX_TRT_CACHE_DIR=/tmp/trt_cache

# Worker d'inférence dédié (producteur-consommateur). true = défaut.
FACE_INFERENCE_WORKER=true
# Taille du pool : 1 = une session partagée (~1 Go) ; >1 = une session par worker
# (≈ +1 Go chacune) pour plus de débit. Limité par la VRAM (RTX 4050 = 6 Go).
FACE_INFERENCE_WORKERS=1
FACE_INFER_TIMEOUT=10


# ----------------------
# Tracking multi-caméra (optionnel — valeurs par défaut ci-dessous)
# ----------------------
# Durée de vie du cache d'identité global en secondes (5 minutes par défaut)
# Une personne reconnue est gardée en mémoire pendant cette durée inter-caméras.
GLOBAL_CACHE_TTL_SECONDS=300

# Seuil de similarité du cache d'identité inter-caméras (cosine brut 0.0–1.0).
# Un hit cache CONFIRME une identité et court-circuite le vote temporel → il doit
# être PLUS STRICT que le seuil de reconnaissance (0.45). 0.55 = défaut prudent ;
# monter vers 0.60 pour un cache encore plus sûr. (L'ancien 0.75 relevait d'une
# échelle (cosine+1)/2 désormais caduque — ne pas réutiliser.)
GLOBAL_SIMILARITY_THRESHOLD=0.55


# ----------------------
# LPR / ANPR — reconnaissance des plaques d'immatriculation (optionnel)
# ----------------------
# Activer le pipeline LPR. false = désactivé (pilotable aussi via le frontend).
ENABLE_PLATE_RECOGNITION=false

# Chemin du modèle YOLO de détection de plaque (poids .pt Ultralytics).
# Si absent, le module se désactive proprement sans casser le facial.
PLATE_MODEL_PATH=license_plate_detector.pt

# Seuils détection / OCR
PLATE_DETECTION_CONFIDENCE=0.45
PLATE_OCR_MIN_CONFIDENCE=0.40
PLATE_OCR_GOOD_CONFIDENCE=0.65
PLATE_OCR_MAX_ATTEMPTS=5

# Langues EasyOCR (séparées par des virgules) et caractères autorisés
PLATE_OCR_LANGS=en
PLATE_OCR_ALLOWLIST=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789

# Bornes de longueur plausible d'une plaque
PLATE_MIN_CHARS=4
PLATE_MAX_CHARS=10

# Seuil de similarité fuzzy pour /plates/search côté backend (0.0–1.0)
PLATE_SEARCH_THRESHOLD=0.82

# ── Optimisations LPR : latence & précision (défauts sûrs ; à ajuster sur TA vidéo)
# Latence — détection YOLO 1 frame traitée sur N (le cache OCR couvre le reste) :
PLATE_PROCESS_EVERY_N=2
# Latence — FP16 du YOLO sur GPU (repli FP32 automatique si non supporté) :
PLATE_YOLO_HALF=true
# Latence — taille de la file de résolution réseau découplée :
PLATE_LOOKUP_QUEUE_MAXSIZE=64
# Latence/précision — ne pas OCR les plaques trop petites (px) :
PLATE_MIN_CROP_WIDTH=60
PLATE_MIN_CROP_HEIGHT=18
# Précision — filtre de netteté du crop (variance Laplacien ; 0 = désactivé) :
PLATE_CROP_MIN_SHARPNESS=0.0
# Précision — vote temporel multi-frames (agrégation OCR le long d'un track) :
PLATE_TEMPORAL_VOTING=true
PLATE_VOTE_MIN_AGREE=2
# Précision — pré-traitement du crop avant OCR (upscale + CLAHE) :
PLATE_PREPROCESS=true
PLATE_PREPROCESS_TARGET_HEIGHT=64
# Précision — robustesse FORTE LUMIÈRE (anti glare/surexposition, conditionnel) :
PLATE_ILLUMINATION_ROBUST=true
# Précision — deskew (correction de perspective) — plus agressif, désactivé par défaut :
PLATE_DESKEW=false
# Précision — validation par format (regex). Vide = désactivé. Ex. : '^[A-Z0-9]{6,8}$'
PLATE_FORMAT_REGEX=
