# =====================================================
# CONFIGURATION OSIRION-CORE
# =====================================================
# Copier ce fichier en ".env" et remplir avec vos valeurs réelles.
# IMPORTANT : Ne jamais committer le fichier .env dans git.
#
# Démarrage rapide :
#   cp .env.example .env
#   # éditer .env avec vos valeurs
#   docker compose up -d
# =====================================================


# ----------------------
# API Backend (obligatoire)
# ----------------------
# URL de base du serveur API (avec slash final)
API_URL=http://192.168.0.103:8000/

# Identifiants de connexion à l'API
AUTH_EMAIL=votre-email@example.com
AUTH_PASSWORD=votre-mot-de-passe-securise


# ----------------------
# Sécurité WebSocket (obligatoire)
# ----------------------
# Secret Flask pour signer les sessions — NE JAMAIS hardcoder en production.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=GENERER_UN_SECRET_ALEATOIRE_ICI

# Origines autorisées pour les connexions WebSocket (séparées par des virgules).
# Développement : http://localhost:3000,http://127.0.0.1:3000
# Production    : https://votre-domaine.com
# Toutes        : * (DANGEREUX — ne pas utiliser en production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ----------------------
# Mode debug (optionnel)
# ----------------------
debug=False


# ----------------------
# Logging (optionnel — valeurs par défaut ci-dessous)
# ----------------------
# Niveau : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Répertoire de sortie des fichiers de logs
LOG_DIR=logs

# Logs JSON structurés (recommandé pour agrégateurs comme Loki, ELK)
ENABLE_JSON_LOGS=false

# Sortie console (désactiver pour réduire le bruit en production)
ENABLE_CONSOLE_LOGS=true

# Taille maximale d'un fichier de log avant rotation (en octets, 10 MB par défaut)
LOG_MAX_BYTES=10485760

# Nombre de fichiers de backup à conserver après rotation
LOG_BACKUP_COUNT=5


# ----------------------
# Tracking multi-caméra (optionnel — valeurs par défaut ci-dessous)
# ----------------------
# Durée de vie du cache d'identité global en secondes (5 minutes par défaut)
# Une personne reconnue est gardée en mémoire pendant cette durée inter-caméras.
GLOBAL_CACHE_TTL_SECONDS=300

# Seuil de similarité pour matcher les embeddings entre caméras (0.0–1.0).
# Plus la valeur est élevée, plus le matching est strict.
# 0.75 = bon équilibre précision / rappel.
GLOBAL_SIMILARITY_THRESHOLD=0.75


# ----------------------
# LPR / ANPR — reconnaissance des plaques d'immatriculation (optionnel)
# ----------------------
# Activer le pipeline LPR. false = désactivé (pilotable aussi via le frontend).
ENABLE_PLATE_RECOGNITION=false

# Chemin du modèle YOLO de détection de plaque (poids .pt Ultralytics).
# Si absent, le module se désactive proprement sans casser le facial.
PLATE_MODEL_PATH=license_plate_detector.pt

# Seuils détection / OCR
PLATE_DETECTION_CONFIDENCE=0.45
PLATE_OCR_MIN_CONFIDENCE=0.40
PLATE_OCR_GOOD_CONFIDENCE=0.65
PLATE_OCR_MAX_ATTEMPTS=5

# Langues EasyOCR (séparées par des virgules) et caractères autorisés
PLATE_OCR_LANGS=en
PLATE_OCR_ALLOWLIST=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789

# Bornes de longueur plausible d'une plaque
PLATE_MIN_CHARS=4
PLATE_MAX_CHARS=10

# Seuil de similarité fuzzy pour /plates/search côté backend (0.0–1.0)
PLATE_SEARCH_THRESHOLD=0.82
