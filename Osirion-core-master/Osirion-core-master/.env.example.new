# Exemple de fichier .env mis à jour avec configuration logging
# =====================================================
# CONFIGURATION OSIRION-CORE - Exemple
# =====================================================
# Copier ce fichier en ".env" et remplir avec vos valeurs

# ----------------------
# API Backend
# ----------------------
API_URL=http://192.168.0.103:8000/
AUTH_EMAIL=votre-email@example.com
AUTH_PASSWORD=votre-mot-de-passe-securise

# ----------------------
# Mode debug
# ----------------------
debug=False

# ----------------------
# Sécurité WebSocket
# ----------------------
# Secret Flask pour signer les sessions
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT : Changer cette valeur en production !
FLASK_SECRET_KEY=GENERER_UN_SECRET_ALEATOIRE_ICI

# CORS : Origines autorisées pour WebSocket (séparées par des virgules)
# Exemples :
# - Développement : http://localhost:3000,http://127.0.0.1:3000
# - Production : https://votre-domaine.com
# - Tous (DANGEREUX) : *
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------
# Configuration du Logging
# ----------------------
# Niveau de log : DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Répertoire des fichiers de logs
LOG_DIR=logs

# Activer les logs JSON structurés (recommandé pour production)
ENABLE_JSON_LOGS=false

# Activer l'affichage console (utile en développement)
ENABLE_CONSOLE_LOGS=true

# Taille maximum d'un fichier de log avant rotation (en octets)
# 10485760 = 10 MB
LOG_MAX_BYTES=10485760

# Nombre de fichiers de backup à conserver
LOG_BACKUP_COUNT=5

# ----------------------
# Configuration du Tracking Multi-Caméra Global
# ----------------------
# Durée de vie du cache global en secondes (300 = 5 minutes)
# Une personne reconnue reste dans le cache pendant cette durée
GLOBAL_CACHE_TTL_SECONDS=300

# Seuil de similarité pour matcher les embeddings entre caméras (0.0-1.0)
# Plus la valeur est élevée, plus le matching est strict
# 0.75 = bon équilibre entre précision et rappel
GLOBAL_SIMILARITY_THRESHOLD=0.75
