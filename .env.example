# =============================================================================
# Osirion — Variables d'environnement globales
# =============================================================================
# Copier ce fichier en .env puis remplir toutes les valeurs marquées REQUIRED.
#   cp .env.example .env
#
# IMPORTANT : Ne jamais committer le fichier .env dans git.
# =============================================================================


# =============================================================================
# BASE DE DONNÉES (PostgreSQL)
# =============================================================================

# Identifiants PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REQUIRED_change_this          # ← REQUIRED
POSTGRES_DB=Osirion-AI


# =============================================================================
# BACKEND (FastAPI)
# =============================================================================

# Clé secrète JWT — générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REQUIRED_change_this                 # ← REQUIRED

# Clé Fernet pour le chiffrement — générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REQUIRED_change_this                 # ← REQUIRED

# Origines CORS autorisées pour le backend (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Durée de vie des tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_PER_MINUTE=5/minute
RATE_LIMIT_GENERAL=100/minute


# =============================================================================
# CORE (Flask — surveillance multi-caméras)
# =============================================================================

# Compte utilisateur du backend pour que le core s'authentifie (mode JWT, repli si
# CORE_API_KEY est vide). Requis seulement si CORE_API_KEY n'est PAS défini.
AUTH_EMAIL=REQUIRED_admin@example.com           # ← REQUIRED (compte existant dans le backend)
AUTH_PASSWORD=REQUIRED_change_this              # ← REQUIRED

# ── RECOMMANDÉ ── Clé de service partagée backend↔core (auth machine-à-machine).
# Si définie, le Core s'authentifie par X-API-Key : PLUS de login/refresh, donc plus
# jamais d'expiration ni de déconnexion. Générer un secret long avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Laisser vide pour retomber sur l'auth JWT email/password ci-dessus.
CORE_API_KEY=

# Secret Flask pour signer les sessions WebSocket — générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REQUIRED_change_this           # ← REQUIRED

# =============================================================================
# SOURCE DE FLUX HIKCENTRAL (OpenAPI Gateway, AK/SK) — optionnel
# =============================================================================
# Si renseigné, le backend peut synchroniser le catalogue de caméras (par groupe)
# et résoudre des URLs RTSP standard (rtsp_s). Vide = connecteur désactivé.
HIK_HOST=                       # ex. https://137.74.118.35:443 (OpenAPI Gateway)
HIK_APP_KEY=                    # Integration Partner Key
HIK_APP_SECRET=                 # Integration Partner Secret
HIK_USER_ID=                    # Linked User du partner (ex. admin)
HIK_VERIFY_SSL=false            # certif auto-signé → false en dev
HIK_STREAM_TYPE=1               # 0=main (HEVC 1440p), 1=sub (HEVC 360p, léger) → ingestion
# Transcodage HEVC→H.264. Flux HikCentral en H.265 non lu par le WebRTC navigateur
# → ré-encodage H.264 obligatoire. ⚠ Le relais ffmpeg tourne DANS le conteneur
# mediamtx (image bluenviron/mediamtx:latest-ffmpeg) : l'encodeur doit exister dans
# CETTE image (libx264 / h264_qsv / h264_vaapi / h264_vulkan — PAS nvenc).
#   DÉFAUT      : libx264 (CPU, quasi gratuit sur un 360p@10fps).
#   Intel/AMD   : h264_vaapi ou h264_qsv (monter /dev/dri dans le service mediamtx).
#   NVIDIA nvenc: exige une image mediamtx custom (ffmpeg nvenc + GPU monté).
HIK_TRANSCODE_ENCODER=libx264
# Options ffmpeg couplées à l'encodeur (adapter si vous changez d'encodeur) :
HIK_TRANSCODE_FLAGS=-preset veryfast -tune zerolatency -crf 26 -g 20
HIK_ONDEMAND_START_TIMEOUT=30s  # démarrage SMS lent à la 1re connexion
HIK_SYNC_INTERVAL_MINUTES=15    # synchro auto du catalogue (0 = manuelle seulement)

# Origines autorisées pour les connexions WebSocket (séparées par des virgules).
# PRODUCTION : remplacer par l'IP/domaine exact du dashboard.
# Exemples :
#   CORS_ALLOWED_ORIGINS=http://192.168.1.10:3000
#   CORS_ALLOWED_ORIGINS=https://dashboard.company.com
#   CORS_ALLOWED_ORIGINS=http://192.168.1.10:3000,http://192.168.1.11:3000
# ⚠️  Ne PAS utiliser '*' en production (risque de leak du flux vidéo).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# ----------------------
# Détection de personnes (Vision Engine anonyme — YOLO26, COCO classe 0)
# ----------------------
# Modèle YOLO (défaut yolo26n : NMS-free, edge-optimisé, ~5 Mo). Auto-téléchargé
# au build ; surcharger le chemin/nom au besoin.
PERSON_MODEL_PATH=yolo26n.pt
# Confiance minimale des détections retenues (0-1).
PERSON_DETECTION_CONFIDENCE=0.4
# Demi-précision FP16 sur GPU (repli FP32 automatique).
PERSON_YOLO_HALF=true
# Gate anti-flou : une frame dont la netteté (variance Laplacien) < seuil est
# sautée (pas d'inférence). 0 = désactivé.
BLUR_THRESHOLD=80.0


# =============================================================================
# NOTIFICATIONS D'ALERTE (SMTP + webhook) — optionnel, déclenché manuellement
# =============================================================================
# Pour Gmail : activer la validation en 2 étapes puis créer un « mot de passe
# d'application » (16 caractères, à saisir sans espaces). NE JAMAIS committer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASSWORD=motdepassedapplication
SMTP_FROM=votre.adresse@gmail.com
SMTP_USE_TLS=true
ALERT_EMAIL_TO=destinataire@exemple.com
ALERT_WEBHOOK_URL=


# =============================================================================
# NOTES
# =============================================================================
# - DATABASE_URL est construit dynamiquement dans le docker-compose à partir
#   de POSTGRES_USER, POSTGRES_PASSWORD et POSTGRES_DB — ne pas le définir ici.
# - API_URL du core est fixé à http://backend:8000/ dans le docker-compose
#   (réseau interne Docker) — ne pas le surcharger ici.
# - NEXT_PUBLIC_* sont définis dans le docker-compose pour le frontend.
